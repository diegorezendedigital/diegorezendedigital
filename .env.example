# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (pública, protegida pelas regras RLS do banco)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SOMENTE no servidor (variável da Vercel). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Livre (https://developers.mercadolivre.com.br/devcenter) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IGUAL à URI de redirect cadastrada no app do ML
ML_REDIRECT_URI=https://SEU-APP.vercel.app/api/ml/callback
# Texto aleatório longo (ex.: openssl rand -hex 32), usado para assinar o "state" do OAuth
ML_STATE_SECRET=
