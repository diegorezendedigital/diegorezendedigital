# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (pública, protegida pelas regras RLS do banco)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SOMENTE no servidor (variável da Vercel). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Livre (https://developers.mercadolivre.com.br/devcenter) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IGUAL à URI de redirect cadastrada no app do ML
ML_REDIRECT_URI=https://SEU-APP.vercel.app/api/ml/callback
# Texto aleatório longo (ex.: openssl rand -hex 32), usado para assinar o "state" do OAuth
ML_STATE_SECRET=

# --- Stripe (assinatura para criar conta) ---
# Chave secreta (sk_live_… ou sk_test_…), SOMENTE no servidor
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_…); endpoint: https://SEU-SITE/api/stripe/webhook
# Eventos: checkout.session.completed e customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes criados no Stripe (price_…)
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
# Textos mostrados na página /planos (ex.: R$ 97 e R$ 970)
NEXT_PUBLIC_PRECO_MENSAL=
NEXT_PUBLIC_PRECO_ANUAL=
